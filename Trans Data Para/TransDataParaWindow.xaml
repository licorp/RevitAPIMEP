<Window x:Class="Quoc_MEP.TransDataParaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy Dữ Liệu Giữa Parameters" 
        Height="1000" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#388E3C" 
                                BorderThickness="1" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#388E3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#D32F2F" 
                                BorderThickness="1" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <StackPanel Margin="20">
            <!-- Category Filter -->
            <GroupBox Header="" Foreground="#333333" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <!-- Search TextBox -->
                    <TextBlock Text="Filter list:" Foreground="#333333" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="CategorySearchBox" 
                             Height="28" 
                             Padding="5"
                             Background="White"
                             BorderThickness="1"
                             BorderBrush="#CCCCCC"
                             FontSize="12"
                             Foreground="#333333"
                             TextChanged="CategorySearchBox_TextChanged"/>
                    
                    <!-- Hide Unselected Checkbox -->
                    <CheckBox x:Name="HideUnselectedCategoriesCheckBox"
                              Content="Hide un-checked categories"
                              Foreground="#333333"
                              FontSize="11"
                              Margin="0,8,0,8"
                              Checked="HideUnselectedCategoriesCheckBox_Changed"
                              Unchecked="HideUnselectedCategoriesCheckBox_Changed"/>
                    
                    <!-- Select Categories ListBox -->
                    <ListBox x:Name="CategoryListBox" 
                             Height="200" 
                             Background="White"
                             BorderThickness="1"
                             BorderBrush="#999999"
                             SelectionMode="Multiple"
                             FontSize="11"
                             Padding="5"
                             SelectionChanged="CategoryListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding}" 
                                          IsChecked="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}"
                                          Foreground="#333333"
                                          FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Check All / Check None Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button x:Name="CheckAllButton" 
                                Content="Check All" 
                                Grid.Column="0"
                                Height="28"
                                Margin="0,0,5,0"
                                FontSize="11"
                                Click="CheckAllButton_Click"
                                Background="White"
                                BorderBrush="#999999"
                                Cursor="Hand"/>
                                
                        <Button x:Name="CheckNoneButton" 
                                Content="Check None" 
                                Grid.Column="1"
                                Height="28"
                                Margin="5,0,0,0"
                                FontSize="11"
                                Click="CheckNoneButton_Click"
                                Background="White"
                                BorderBrush="#999999"
                                Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Group được Copy (Nguồn) -->
            <GroupBox Header="Group được copy" Foreground="#333333" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <!-- Group Name ComboBox (editable + dropdown) -->
                    <TextBlock Text="Group name" Foreground="#333333" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="SourceGroupCombo" 
                              IsEditable="True" 
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              Height="32" 
                              Margin="0,0,0,10"
                              Background="White"
                              FontSize="12"
                              SelectionChanged="SourceGroupCombo_SelectionChanged"
                              DropDownOpened="SourceGroupCombo_DropDownOpened">
                    </ComboBox>

                    <!-- Parameter Name ComboBox (editable + dropdown) -->
                    <TextBlock Text="Parameter name" Foreground="#333333" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="SourceParameterCombo" 
                              IsEditable="True" 
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              Height="32"
                              Background="White"
                              FontSize="12"
                              SelectionChanged="SourceParameterCombo_SelectionChanged"
                              DropDownOpened="SourceParameterCombo_DropDownOpened">
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <!-- Group bị copy (Đích) -->
            <GroupBox Header="Group bị copy" Foreground="#333333" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <!-- Group Name ComboBox (editable + dropdown) -->
                    <TextBlock Text="Group Name" Foreground="#333333" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="TargetGroupCombo" 
                              IsEditable="True" 
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              Height="32" 
                              Margin="0,0,0,10"
                              Background="White"
                              FontSize="12"
                              SelectionChanged="TargetGroupCombo_SelectionChanged"
                              DropDownOpened="TargetGroupCombo_DropDownOpened">
                    </ComboBox>

                    <!-- Parameter Name ComboBox (editable + dropdown) -->
                    <TextBlock Text="Parameter Name" Foreground="#333333" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="TargetParameterCombo" 
                              IsEditable="True" 
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              Height="32"
                              Background="White"
                              FontSize="12"
                              SelectionChanged="TargetParameterCombo_SelectionChanged"
                              DropDownOpened="TargetParameterCombo_DropDownOpened">
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <!-- Copy Options -->
            <GroupBox Header="Copy Options" Foreground="#333333" Margin="0,0,0,15" Height="62">
                <StackPanel Margin="10">
                    <CheckBox x:Name="OverwriteExistingCheckBox"
                              Content="Overwrite existing values (ghi đè giá trị đã có)"
                              Foreground="#333333"
                              FontSize="12"
                              IsChecked="False"
                              ToolTip="Unchecked: Only copy to empty/null parameters (pyRevit style)&#x0a;Checked: Overwrite all parameters including existing values"/>
                    
                    <TextBlock 
                               Foreground="#666666" 
                               FontSize="10" 
                               Margin="20,5,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <!-- Buttons -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="RunButton" 
                        Content="Run" 
                        Grid.Column="0"
                        Style="{StaticResource RunButtonStyle}"
                        Height="40"
                        Margin="50,0,10,0"
                        FontSize="14"
                        Click="RunButton_Click"
                        Cursor="Hand"/>
                        
                <Button x:Name="CloseButton" 
                        Content="Close" 
                        Grid.Column="1"
                        Style="{StaticResource CancelButtonStyle}"
                        Height="40"
                        Margin="10,0,50,0"
                        FontSize="14"
                        Click="CloseButton_Click"
                        Cursor="Hand"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>